# =============================================================================
# Schema Registry — environment variables
# Copy to .env and adjust values:  cp .env.example .env
# =============================================================================

# --- Required (core) -----------------------------------------------------------

# PostgreSQL connection string (API service)
DATABASE_URL=postgres://registry:registry@localhost:5432/schema_registry

# Backend API listen port
API_PORT=3001

# Frontend web UI host port (maps to container port 80)
FRONTEND_PORT=8080

# Static API key for POST/PUT/DELETE (header: X-API-KEY)
API_KEY=a-secure-test-api-key-12345

# --- Database (docker-compose db service) --------------------------------------

POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
POSTGRES_DB=schema_registry

# Host port for PostgreSQL (optional; default 5432)
POSTGRES_PORT=5432

# --- API (optional) ------------------------------------------------------------

# Seed JSON files directory (default in Docker: /app/seeds)
SEED_DIR=./seeds

# Legacy alias supported by the API: PORT (falls back if API_PORT unset)
# PORT=3001

# --- Frontend build (Vite; used at docker build / npm run build) ---------------

# Leave empty in Docker so nginx proxies /schemas and /validate to the API
VITE_API_URL=http://localhost:3001

# Must match API_KEY for mutating requests from the UI
VITE_API_KEY=a-secure-test-api-key-12345
